# 环境变量模板（仅变量名，不含任何真实值。复制为 .env 后填写，.env 已被 .gitignore 屏蔽）
# Notion 内部集成 token（只授权「AI 自媒体系统」页面）
NOTION_TOKEN=

# 可选：aihot 基址（默认 https://aihot.news）
AIHOT_BASE_URL=https://aihot.news

# 可选：Notion 根页面 id（AI 自媒体系统）
NOTION_ROOT_PAGE_ID=408d7d3b292381068024e0548308c638

# X 关注名单文件路径（由 Grok Bot 交付，含个人信息，不入公开库）
X_FOLLOWING_PATH=/workspace/ai-zimeiti/inputs/x_following.json

# OpenCode Go（LLM 主提供方；密钥只填本地 .env，不入公开库）
OPENCODE_GO_API_KEY=
# 示例：https://<你的-opencode-go-服务地址>/v1
OPENCODE_GO_API_BASE=
OPENCODE_GO_MODEL=

# DeepSeek（LLM 付费回退，最后）；密钥只填本地 .env
DEEPSEEK_API_KEY=
# 示例：https://<你的-deepseek-服务地址>/v1
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=

# GitHub 官方 REST（可选，提高速率上限；只读公开元数据）
GITHUB_TOKEN=
